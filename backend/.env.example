DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=umoja_funds
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,*.localhost
FRONTEND_URL=http://localhost:5173
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USERNAME=your-mailjet-api-key
SMTP_PASSWORD=your-mailjet-secret-key
SMTP_FROM=no-reply@yourdomain.com
SMTP_USE_TLS=true
ALLOW_PUBLIC_SIGNUP=true
SESSION_HOURS=12
MAX_REQUEST_BYTES=1000000
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Safaricom Daraja M-Pesa STK Push
# Sandbox still requires Daraja sandbox credentials and a public callback URL.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-api.example.com/api/mpesa/stk/callback
MPESA_STK_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_REQUEST_TIMEOUT_SECONDS=30

# OAuth sign-in providers. Create each app in the provider console and add:
# http://localhost:8000/api/auth/oauth/<provider>/callback
# as the redirect URI, replacing <provider> with google, facebook, or microsoft.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
